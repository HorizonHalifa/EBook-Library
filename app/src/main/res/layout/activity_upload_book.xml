<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.UploadBookActivity"
    android:padding="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/editTextTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/book_title_upload"
                android:inputType="textCapWords"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/editTextAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/author"
                android:inputType="textCapWords"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/editTextDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="top"
                android:hint="@string/description"
                android:inputType="textMultiLine"
                android:minHeight="48dp"
                android:minLines="1"
                android:textColorHint="#8D6E63" />

            <Button
                android:id="@+id/buttonSelectCover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/select_cover_image_jpg_png"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/textViewCoverSelected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_image_selected"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/buttonSelectPdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/select_pdf_file"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/textViewPdfSelected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_pdf_selected"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Back Button -->

    <!-- Upload Button -->

    <Button
        android:id="@+id/buttonUpload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@android:color/holo_blue_dark"
        android:text="@string/upload_book_upload"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@+id/buttonBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

    <Button

        android:id="@+id/buttonBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="72dp"
        android:backgroundTint="@android:color/holo_blue_dark"
        android:text="@string/back_upload"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>